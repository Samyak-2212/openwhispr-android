<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="AI Settings">
        <ListPreference
            app:key="ai_provider"
            app:title="AI Provider"
            app:summary="Select the AI provider to use"
            app:entries="@array/ai_providers"
            app:entryValues="@array/ai_providers_values"
            app:defaultValue="openai" />
    </PreferenceCategory>
</PreferenceScreen>
